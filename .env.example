# vLLM-Omni text-to-image server
VLLM_OMNI_URL=http://8091--main--frontier--idp-lab.coder.vts-ai.space

# vLLM-Omni image-to-image server
VLLM_OMNI_EDIT_URL=https://8092--main--frontier--idp-lab.coder.vts-ai.space

# Optional credentials (leave empty when authentication is disabled)
VLLM_OMNI_API_KEY=
VLLM_OMNI_EDIT_API_KEY=

# Maximum time to wait for a remote generation request
VLLM_OMNI_TIMEOUT_SECONDS=1800

# GPU visible to this app process/container. Remote vLLM servers configure
# their own GPU selection separately.
GPU_ID=0
